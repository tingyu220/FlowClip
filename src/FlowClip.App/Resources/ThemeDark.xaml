<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题画刷 -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1C1E" Opacity="0.82"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2E" Opacity="0.72"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98989D"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFFFFF" Opacity="0.10"/>
    <SolidColorBrush x:Key="SearchBoxBrush" Color="#3A3A3C" Opacity="0.65"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FFFFFF" Opacity="0.06"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#0A84FF" Opacity="0.22"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#FFFFFF" Opacity="0.06"/>
    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#0A84FF" Opacity="0.30"/>
    <SolidColorBrush x:Key="ChipSelectedTextBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#98989D" Opacity="0.5"/>
    <!-- 失效 / 警示：低饱和红，避免大面积高饱和色块 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" Opacity="0.85"/>
    <!-- 选中边框：比强调色本体更淡，选中感主要交给左侧强调线表达 -->
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#0A84FF" Opacity="0.45"/>
    <!-- 操作按钮底色 -->
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF" Opacity="0.12"/>
</ResourceDictionary>
