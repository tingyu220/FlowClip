<Window x:Class="FlowClip.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FlowClip.Core.Models;assembly=FlowClip.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FlowClip"
        Width="600" Height="480"
        MinWidth="420" MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True">
    <!-- 使用 WindowChrome 把 DWM 玻璃框扩展到整窗，配合 DwmSetWindowAttribute 的圆角偏好，
         使窗口由 DWM 原生绘制圆角；玻璃框透明，四角不再露出黑色矩形背景。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1"
                           ResizeBorderThickness="6"
                           CaptionHeight="0"
                           CornerRadius="10"
                           UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Panel" CornerRadius="10"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="18"
            Effect="{StaticResource SoftShadow}">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="{StaticResource DurNormal}"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="0.96" To="1" Duration="{StaticResource DurNormal}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：整条区域均可拖动（Background 必须为 Transparent，
                 否则 Grid 空白处不参与命中测试，就只有 logo 那块能拖） -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Margin="2,0,2,10"
                  Background="Transparent"
                  MouseLeftButtonDown="OnHeaderDrag">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Cursor="SizeAll">
                    <Border Width="26" Height="26" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A84FF" Offset="0"/>
                                <GradientStop Color="#5E5CE6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="FlowClip" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="切换深浅色"
                            Content="◐" FontSize="16" Click="OnToggleThemeClick"/>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="最小化到托盘"
                            Content="—" FontSize="14" Margin="4,0,0,0" Click="OnMinimizeClick"/>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="隐藏面板 (Esc)"
                            Content="✕" FontSize="14" Margin="4,0,0,0" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>

            <!-- 搜索框 -->
            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchBoxStyle}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Margin="2,0,2,12"/>

            <!-- 筛选芯片：WrapPanel 而非 StackPanel —— 窗口收窄时自动换行，
                 避免标签被挤压溢出，也无需为紧凑模式复制一套独立 UI -->
            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,2,10">
                <ToggleButton Style="{StaticResource ChipButtonStyle}" Content="全部"
                              Tag="{x:Null}"
                              IsChecked="{Binding ActiveFilter, Converter={StaticResource FilterIsChecked}, ConverterParameter={x:Null}, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <ToggleButton Style="{StaticResource ChipButtonStyle}" Content="文字" Margin="8,0,0,0"
                              Tag="{x:Static core:ClipItemType.Text}"
                              IsChecked="{Binding ActiveFilter, Converter={StaticResource FilterIsChecked}, ConverterParameter={x:Static core:ClipItemType.Text}, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <ToggleButton Style="{StaticResource ChipButtonStyle}" Content="图片" Margin="8,0,0,0"
                              Tag="{x:Static core:ClipItemType.Image}"
                              IsChecked="{Binding ActiveFilter, Converter={StaticResource FilterIsChecked}, ConverterParameter={x:Static core:ClipItemType.Image}, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <ToggleButton Style="{StaticResource ChipButtonStyle}" Content="链接" Margin="8,0,0,0"
                              Tag="{x:Static core:ClipItemType.Link}"
                              IsChecked="{Binding ActiveFilter, Converter={StaticResource FilterIsChecked}, ConverterParameter={x:Static core:ClipItemType.Link}, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <ToggleButton Style="{StaticResource ChipButtonStyle}" Content="文件" Margin="8,0,0,0"
                              Tag="{x:Static core:ClipItemType.File}"
                              IsChecked="{Binding ActiveFilter, Converter={StaticResource FilterIsChecked}, ConverterParameter={x:Static core:ClipItemType.File}, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <ToggleButton Style="{StaticResource ChipButtonStyle}" Content="文件夹" Margin="8,0,0,0"
                              Tag="{x:Static core:ClipItemType.Folder}"
                              IsChecked="{Binding ActiveFilter, Converter={StaticResource FilterIsChecked}, ConverterParameter={x:Static core:ClipItemType.Folder}, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <ToggleButton Style="{StaticResource ChipButtonStyle}" Content="多文件" Margin="8,0,0,0"
                              Tag="{x:Static core:ClipItemType.MultiFile}"
                              IsChecked="{Binding ActiveFilter, Converter={StaticResource FilterIsChecked}, ConverterParameter={x:Static core:ClipItemType.MultiFile}, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            </WrapPanel>

            <!-- 列表 -->
            <ListBox x:Name="ClipList" Grid.Row="3" Style="{StaticResource ClipListBoxStyle}"
                     ItemsSource="{Binding Items}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ClipItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 徽标区（42×42）：按条目类型选择最合适的呈现方式 -->
                            <Grid Width="42" Height="42" VerticalAlignment="Top" Margin="0,0,12,0">
                                <!-- ① 图片：真实缩略图（IsAsync 后台解码，只解码到目标宽度，不整文件入内存） -->
                                <Rectangle Width="42" Height="42" RadiusX="9" RadiusY="9"
                                           Visibility="{Binding Converter={StaticResource ImageThumbVisibility}}">
                                    <Rectangle.Fill>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding IsAsync=True, Converter={StaticResource ImageThumb}}"/>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- ② 文字 / 链接：彩色单字徽标 -->
                                <Border Width="42" Height="42" CornerRadius="11"
                                        Background="{Binding Type, Converter={StaticResource TypeToBadgeBrush}}"
                                        Visibility="{Binding Converter={StaticResource BadgeVisibility}}">
                                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeToGlyph}}"
                                               Foreground="White" FontWeight="SemiBold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- ③ 文件 / 文件夹 / 多文件：Windows Shell 提供的真实类型图标 -->
                                <Border Width="42" Height="42" CornerRadius="9" Background="Transparent"
                                        Visibility="{Binding Converter={StaticResource FileIconVisibility}}">
                                    <Image Source="{Binding Converter={StaticResource FileIcon}}"
                                           Width="32" Height="32" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- 多文件 / 文件夹数量角标 -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{DynamicResource ChipBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="5,1" Margin="0,0,-2,-2"
                                        Visibility="{Binding FileCount, Converter={StaticResource HideWhenEmpty}}">
                                    <TextBlock Text="{Binding FileCount, StringFormat=×{0}}"
                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Preview}"
                                           Visibility="{Binding Preview, Converter={StaticResource HideWhenEmpty}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="·" FontSize="11" Margin="6,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}"
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding SourceApp}" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Visibility="{Binding SourceApp, Converter={StaticResource HideWhenEmpty}}"/>
                                    <TextBlock Text="{Binding SizeBytes, Converter={StaticResource FileSize}}"
                                               FontSize="11" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Visibility="{Binding SizeBytes, Converter={StaticResource HideWhenEmpty}}"/>
                                    <!-- 源文件已失效：明确告知不可用，而不是让卡片看起来仍可粘贴 -->
                                    <Border CornerRadius="5" Background="{DynamicResource DangerBrush}"
                                            Padding="5,1" Margin="6,0,0,0"
                                            Visibility="{Binding Converter={StaticResource MissingVisibility}}">
                                        <TextBlock Text="源文件已失效" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="6,2"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="置顶" FontSize="10" Foreground="White"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 底部提示：只保留最高频操作，其余说明移出主界面以降低视觉权重 -->
            <TextBlock Grid.Row="4" Margin="4,8,4,0" FontSize="11" Opacity="0.75"
                       Background="Transparent"
                       MouseLeftButtonDown="OnHeaderDrag"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="↑↓ 选择 · Enter 复制并粘贴 · Esc 关闭"/>
        </Grid>
    </Border>
</Window>
