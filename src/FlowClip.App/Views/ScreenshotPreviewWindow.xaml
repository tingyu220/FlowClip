<Window x:Class="FlowClip.App.Views.ScreenshotPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="截图预览"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="280"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True">
    <!-- 与历史面板一致：用 WindowChrome 让 DWM 原生绘制圆角，避免外层黑框 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1"
                           ResizeBorderThickness="0"
                           CaptionHeight="0"
                           CornerRadius="10"
                           UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root" CornerRadius="10"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="10"
            Focusable="False"
            MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
            Effect="{StaticResource SoftShadow}">
        <Border.RenderTransform>
            <!-- 出场：轻微横向位移 + 淡入 -->
            <TranslateTransform x:Name="Slide" X="14" Y="0"/>
        </Border.RenderTransform>

        <StackPanel>
            <!-- 截图本体才是视觉主体：没有大标题、没有大图区域留白 -->
            <Border x:Name="ImageHost" CornerRadius="12" ClipToBounds="True"
                    Background="{DynamicResource ChipBrush}">
                <Image x:Name="PreviewImage" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- 来源说明：区分「FlowClip 自己发起的截图」与「第三方写入剪贴板的图片」 -->
            <TextBlock x:Name="SourceLabel" Margin="2,8,2,0" FontSize="10"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- 操作区：只保留少量必要能力；未实现的能力明确禁用，不做假按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButtonStyle}" Content="复制"
                        Padding="12,6,12,6" Click="OnCopyClick"/>
                <Button Style="{StaticResource ActionButtonStyle}" Content="贴屏" Margin="6,0,0,0"
                        Padding="12,6,12,6" IsEnabled="False"
                        ToolTip="贴屏（置顶显示）：尚未实现，暂不可用"
                        Opacity="0.45"/>
                <Button Style="{StaticResource ActionButtonStyle}" Content="关闭" Margin="6,0,0,0"
                        Padding="12,6,12,6" Click="OnCloseClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
